# ==============================================================================
# JobSift Backend Configuration (.env)
# ==============================================================================

# App & Security
PROJECT_NAME="JobSift API"
VERSION="1.0.0"
API_V1_STR="/api"
SECRET_KEY="jobsift-super-secret-jwt-token-key-2026-caffeine-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider (Mistral AI)
# Powers personalized resume analysis, dynamic mock interviews, cover letters & salary negotiation copy.
# Leave blank to use built-in heuristic offline fallback mode.
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"

# Database Connection (SQLite or PostgreSQL / Neon)
# Option 1: Direct URL (Default: SQLite for zero-setup local dev)
DATABASE_URL="sqlite:///./jobsift.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://neondb_owner:your_password@your-host.neon.tech/neondb?sslmode=require"

# Option 2: Individual Postgres Parameters (Optional)
PGHOST=""
PGDATABASE="neondb"
PGUSER=""
PGPASSWORD=""
PGPORT=5432
PGSSLMODE="require"

# CORS Settings
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","*"]'
